# Local development settings matching docker-compose.yml.
# CLI gateway (setup.sh adds CLI_API_BASE_URL if absent).
CLI_API_PORT=8088
CLI_API_TIMEOUT=180
CLI_API_CONCURRENCY=2
CLI_API_FALLBACK=claude,codex,antigravity
# CLI_API_KEY=choose-a-local-secret
# CLI_API_ANTIGRAVITY_COMMAND=["/absolute/container/path/to/headless-wrapper"]
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop
DB_USER=shop
DB_PASSWORD=shop
DB_RO_USER=agent_ro
DB_RO_PASSWORD=agent_ro

VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=vectors
VECTOR_DB_USER=shop
VECTOR_DB_PASSWORD=shop
VECTOR_TABLE=documents
# Required for embedding and search calls, not database setup.

LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-your-litellm-key
LITELLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=openai:text-embedding-3-small
